{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    //"title",
    //"separator",
    {
        "type": "custom",
        "format": "                 ",
    },

    {
        "type": "title",
        "key": " ",
        "keyColor": "blue",
        "format": "{user-name}"
    },
    {
        "type": "host",
        "key": "󰌢 ",
        "keyColor": "blue",
        "format": "{vendor} {name}"
    },
    {
        "type": "os",
        "key": " ",
        "keyColor": "blue",
        "format": "{name} {version}"
    },
    {
        "type": "wm",
        "key": " ",
        "keyColor": "blue",
        "format": "{pretty-name} ({protocol-name})"
    },
    //"os",
    //"host",
    //"kernel",
    //"uptime",
    {
        "type": "uptime",
        "key": " ",
        "keyColor": "blue",
        "format": "{hours} hours, {minutes} mins"
    },
    //"packages",
    //"shell",
    //"display",
    //"de",
    //"wm",
    //"wmtheme",
    //"theme",
    //"icons",
    //"font",
    //"cursor",
    //"terminal",
    //"terminalfont",
    //"cpu",
    {
        "type": "cpu",
        "format": "{name}",
        "key": " ",
        "keyColor": "blue",
    },
    {
        "type": "gpu",
        "format": "{name}",
        "key": "󰡁 ",
        "keyColor": "blue",
    },
    {
        "type": "memory",
        "format": "{total} ({percentage})",
        "key": " ",
        "keyColor": "blue"
    },
    {
        "type": "disk",
        "format": "{name} {size-total} ({size-percentage})",
        "key": "󰋊 ",
        "keyColor": "blue"
    },
    //"gpu",
    //"memory",
    //"swap",
    //"disk",
    //"localip",
    //"battery",
    //"poweradapter",
    //"locale",
    "break",
    //"colors"
  ],
  "logo": {
    "type": "auto",
    "source": "/home/alday/.config/fastfetch/logo.txt",
    //"type": "small",        // Logo type: auto, builtin, small, file, etc.
    //"source": "arch",      // Built-in logo name or file path
    //"width": 65,           // Width in characters (for image logos)
    //"height": 35,          // Height in characters (for image logos)
    "padding": {
        "top": 1,          // Top padding
        "left": 1,         // Left padding
        "right": 3         // Right padding
    },
    "color": {             // Override logo colors
        "1": "blue",
        "2": "blue"
    }
  }
}
